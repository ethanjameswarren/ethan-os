% Ethan Resume Style Package
% Centralizes all presentation decisions for the Ethan OS LaTeX resume template.
% Visual interpretation of ethan-life/global/design-philosophy.md:
%   restrained, precise, intentional, premium without being cold.
% Presentation must never override content accuracy, ATS parsing, or readability.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ethan-resume}[2026/08/13 v2.0 Ethan OS resume style]

% ------------------------------------------------------------------
% PAGE
% ------------------------------------------------------------------
\RequirePackage[letterpaper, margin=0.65in, top=0.55in, bottom=0.55in]{geometry}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% ------------------------------------------------------------------
% TYPOGRAPHY
% ------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[scale=0.95]{tgheros} % clean, modern sans-serif, ATS-safe
\RequirePackage{microtype}          % refined letter spacing

\renewcommand{\familydefault}{\sfdefault}

% ------------------------------------------------------------------
% COLORS
% ------------------------------------------------------------------
% Neutral foundation with a single restrained accent.
\RequirePackage{xcolor}
\definecolor{ethanblack}{HTML}{1A1A1A}
\definecolor{ethandarkgray}{HTML}{333333}
\definecolor{ethanmidgray}{HTML}{666666}
\definecolor{ethanlightgray}{HTML}{888888}
\definecolor{ethanrulegray}{HTML}{CCCCCC}
\definecolor{ethanaccent}{HTML}{2A3F54} % deep steel blue, used sparingly

\color{ethanblack}

% ------------------------------------------------------------------
% LINKS
% ------------------------------------------------------------------
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

% ------------------------------------------------------------------
% LISTS
% ------------------------------------------------------------------
\RequirePackage{etoolbox}
\RequirePackage{enumitem}
\setlist[itemize]{
  leftmargin=1.1em,
  label=\textbullet,
  itemsep=0.10em,
  parsep=0pt,
  topsep=0.18em,
  partopsep=0pt
}

% ------------------------------------------------------------------
% SECTION HEADERS
% ------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{array}

\titleformat{\section}
  {\normalfont\fontsize{11.5}{13}\selectfont\bfseries\color{ethanblack}}
  {}
  {0em}
  {}
  []
\titlespacing*{\section}{0pt}{0.70em}{0.25em}

% ------------------------------------------------------------------
% SPACING SCALE
% ------------------------------------------------------------------
\newcommand{\ethansmallskip}{\vspace{0.25em}}
\newcommand{\ethanmedskip}{\vspace{0.45em}}

% ------------------------------------------------------------------
% HEADER
% ------------------------------------------------------------------
\newcommand{\@name}{}
\newcommand{\name}[1]{\renewcommand{\@name}{#1}}

\newcommand{\@contacts}{}
\newcommand{\contacts}[1]{\renewcommand{\@contacts}{#1}}

\newcommand{\makeheader}{%
  \noindent
  {\fontsize{18}{22}\selectfont\bfseries\color{ethanblack}\@name}\\[0.18em]
  {\small\color{ethanlightgray}\@contacts}
  \vspace{0.60em}
}

% ------------------------------------------------------------------
% CONTENT MACROS
% ------------------------------------------------------------------
% These hold content supplied by the resume builder workflow.
\newcommand{\@summary}{}
\newcommand{\summary}[1]{\renewcommand{\@summary}{#1}}
\newcommand{\makesummary}{%
  \section{Summary}
  \@summary
}

\newcommand{\@skills}{}
\newcommand{\skills}[1]{\renewcommand{\@skills}{#1}}
\newcommand{\makeskills}{%
  \section{Skills}
  \@skills
}

\newcommand{\@experience}{}
\newcommand{\experience}[1]{\renewcommand{\@experience}{#1}}
\newcommand{\makeexperience}{%
  \section{Experience}
  \@experience
}

\newcommand{\@projects}{}
\newcommand{\projects}[1]{\renewcommand{\@projects}{#1}}
\newcommand{\makeprojects}{%
  \section{Selected Projects}
  \@projects
}

\newcommand{\@education}{}
\newcommand{\education}[1]{\renewcommand{\@education}{#1}}
\newcommand{\makeeducation}{%
  \section{Education}
  \@education
}

% ------------------------------------------------------------------
% ENTRY FORMATTING
% ------------------------------------------------------------------
% Resume entry: role/degree, employer/institution, date range, optional location.
%   #1 = role or degree
%   #2 = employer or institution
%   #3 = date range
%   #4 = location (optional, pass empty for none)
\newcommand{\resumeentry}[4]{%
  \vspace{0.30em}
  \noindent
  \begin{tabular}[t]{@{}p{0.67\linewidth}@{\hspace{0.02\linewidth}}>{\raggedleft\arraybackslash}p{0.29\linewidth}@{}}%
    \textbf{#1} \textcolor{ethanmidgray}{| #2} & \textcolor{ethanmidgray}{#3} \\
  \end{tabular}%
  \ifstrempty{#4}{}{\par\nobreak\vspace{0.05em}{\small\color{ethanlightgray} #4}}%
  \vspace{0.05em}
}

% ------------------------------------------------------------------
% SELECTED ACCENT
% ------------------------------------------------------------------
% Use the accent color only where it genuinely clarifies structure.
\newcommand{\ethanaccenttext}[1]{\textcolor{ethanaccent}{#1}}
